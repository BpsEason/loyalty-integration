# Laravel API 設定 (將 localhost 強制改為 127.0.0.1 避免 IPv6 解析問題)
LARAVEL_API_BASE_URL=http://127.0.0.1:8088/api/v1
LARAVEL_EMAIL=admin-r@example.com
LARAVEL_PASSWORD=password123
LARAVEL_COFFEE_EMAIL=admin-c@example.com
LARAVEL_COFFEE_PASSWORD=password123
LARAVEL_COFFEE_CAMPAIGN_REWARD_ID=1

# Reverb WebSocket 設定 (確保 APP_ID 與 Docker/Laravel .env 的 loyalty-app 一致)
REVERB_APP_ID=loyalty-app
REVERB_APP_KEY=loyalty-key
REVERB_APP_SECRET=loyalty-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8888
REVERB_SCHEME=ws
REVERB_AUTH_ENDPOINT=http://127.0.0.1:8088/api/v1/broadcasting/auth

# 預設逾時設定
DEFAULT_TIMEOUT=30.0
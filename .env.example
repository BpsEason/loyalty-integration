# Laravel API 設定
LARAVEL_API_BASE_URL=http://localhost:8088/api/v1
LARAVEL_EMAIL=admin@example.com
LARAVEL_PASSWORD=your-password
LARAVEL_COFFEE_EMAIL=coffee@example.com
LARAVEL_COFFEE_PASSWORD=coffee-password
LARAVEL_COFFEE_CAMPAIGN_REWARD_ID=1

# Reverb WebSocket 設定
REVERB_APP_ID=your-reverb-app-id
REVERB_APP_KEY=your-reverb-app-key
REVERB_APP_SECRET=your-reverb-app-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8888
REVERB_SCHEME=ws
REVERB_AUTH_ENDPOINT=http://localhost:8088/api/v1/broadcasting/auth

# 預設逾時設定
DEFAULT_TIMEOUT=30.0